---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import credits from '../data/photo-credits.json';
import { site } from '../data/site';

// Photos d'illustration provisoires : à retirer au fur et à mesure que les photos du client arrivent.
const used = ['f71613424', 'f76638337', 'f122533004', 'f166946901', 'f134681297', 'f124265840', 'f41632672'];
const photos = credits.photos.filter((p) => used.includes(p.id));
---
<Layout title={`Crédits photos | ${site.name}`} description={`Auteurs et licences des photographies d’illustration du site ${site.name}.`} noindex>
  <Header />
  <main id="contenu" class="bg-ivory pt-36 pb-24 text-text">
    <article class="container-site flex max-w-[48rem] flex-col gap-8">
      <h1 class="text-5xl">Crédits photos</h1>
      <ul class="flex flex-col border-t border-text/12">
        {photos.map((p) => (
          <li class="border-b border-text/12 py-4">
            <a href={p.page} rel="noopener">{p.alt}</a> — {p.by}, {p.source},
            licence <a href={p.licenceUrl} rel="noopener license">{p.licence}</a>.
          </li>
        ))}
      </ul>
      <p><a href="/" class="font-medium">← Retour à l’accueil</a></p>
    </article>
  </main>
</Layout>
