---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import IconBand from '../components/IconBand.astro';
import Intro from '../components/Intro.astro';
import Services from '../components/Services.astro';
import Vehicle from '../components/Vehicle.astro';
import Zone from '../components/Zone.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import { site, areaServed } from '../data/site';
import { faq } from '../data/faq';

const base = site.url;

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${base}/#entreprise`,
  name: site.name,
  description: site.description,
  url: base,
  telephone: site.phoneHref.replace('tel:', ''),
  email: site.email,
  image: `${base}/og-image.png`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    postalCode: site.postalCode,
    addressRegion: site.region,
    addressCountry: 'FR',
  },
  areaServed: areaServed.map((name) => ({ '@type': 'Place', name })),
  ...(site.hours.schema.length ? { openingHours: site.hours.schema } : {}),
};

const taxiService = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  '@id': `${base}/#taxi`,
  name: `${site.name}, taxi conventionné CPAM`,
  serviceType: 'Transport médical assis conventionné et trajets privés',
  provider: { '@id': `${base}/#entreprise` },
  areaServed: [
    { '@type': 'AdministrativeArea', name: site.department },
    { '@type': 'AdministrativeArea', name: site.region },
  ],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: 'Trajets',
    itemListElement: [
      'Consultations et examens médicaux',
      'Dialyse, chimiothérapie, radiothérapie',
      'Entrées et sorties d’hôpital',
      'Transferts gares et aéroport Nantes-Atlantique',
      'Transport d’entreprises et de professionnels',
    ].map((name) => ({ '@type': 'Offer', itemOffered: { '@type': 'Service', name } })),
  },
};

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout
  title="Taxi Saint-Gervais, Challans, Vendée | El Taxi Doizie"
  jsonLd={[business, taxiService, faqPage]}
>
  <Header />
  <main id="contenu">
    <Hero />
    <IconBand
      items={[
        { icon: 'car', title: 'Transport toutes distances' },
        { icon: 'plane', title: 'Transferts gares et aéroports' },
        { icon: 'building', title: 'Transport entreprises et professionnels' },
        { icon: 'cross', title: 'Conventionné CPAM' },
      ]}
    />
    <Intro />
    <Services />
    <IconBand
      title="Pourquoi choisir"
      highlight={site.name}
      items={[
        { icon: 'diamond', title: 'Un service haut de gamme', text: 'Pour un confort optimal' },
        { icon: 'shield', title: 'Une sécurité maximale', text: 'Véhicule récent et entretenu' },
        { icon: 'clock', title: 'Une grande disponibilité', text: site.hours.label },
        { icon: 'handshake', title: 'Un chauffeur à votre écoute', text: 'Pour un service personnalisé' },
      ]}
    />
    <Vehicle />
    <Zone />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
  <MobileCallBar />
</Layout>
