---
import CallButton from './CallButton.astro';

const steps = [
  {
    n: '1',
    title: 'Votre médecin prescrit le transport',
    text: 'Il remplit le bon de transport (prescription médicale de transport) en cochant « taxi conventionné ».',
  },
  {
    n: '2',
    title: 'Vous m’appelez pour réserver',
    text: 'On fixe ensemble l’heure de prise en charge, aller et retour, idéalement la veille.',
  },
  {
    n: '3',
    title: 'Je m’occupe de la facture',
    text: 'Votre carte Vitale et le bon suffisent : la facturation part directement à la CPAM.',
  },
];
---
<section id="prise-en-charge" class="screen-section bg-night text-ink">
  <div class="container-site flex h-full flex-col gap-14 lg:gap-20">
    <div class="flex max-w-[44rem] flex-col gap-5">
      <p class="label text-gold">Prise en charge</p>
      <h2 class="text-4xl leading-[1.08] lg:text-5xl">Trois démarches, aucune avance de frais</h2>
    </div>
    <ol class="grid gap-12 md:grid-cols-3 md:gap-6">
      {steps.map((s) => (
        <li class="flex flex-col gap-5 md:pr-8">
          <span class="flex size-14 items-center justify-center rounded-full border border-gold font-display text-2xl text-gold" aria-hidden="true">{s.n}</span>
          <h3 class="text-2xl leading-snug">{s.title}</h3>
          <p class="text-ink-soft">{s.text}</p>
        </li>
      ))}
    </ol>
    <div class="flex flex-col gap-5 border-t border-white/12 pt-10 md:flex-row md:items-center md:justify-between">
      <p class="max-w-[36rem] text-lg text-ink-soft">
        Pour des soins en série, nous fixons le planning une fois pour toute la durée du traitement.
      </p>
      <CallButton label="Réserver un trajet" class="w-full md:w-auto" />
    </div>
  </div>
</section>
