---
import Icon from './Icon.astro';
interface Item { icon: Parameters<typeof Icon>[0]['name']; title: string; text?: string; }
interface Props { items: Item[]; title?: string; highlight?: string; id?: string; }
const { items, title, highlight, id } = Astro.props;
---
<section id={id} class="bg-night-2 text-ink">
  <div class:list={['container-site', title ? 'py-20 lg:py-24' : 'py-14 lg:py-16']}>
    {title && (
      <div class="mb-14 flex items-center gap-6">
        <span class="h-px flex-1 bg-gold/70" aria-hidden="true"></span>
        <h2 class="text-center text-3xl lg:text-4xl">
          {title} {highlight && <span class="text-gold">{highlight}</span>} ?
        </h2>
        <span class="h-px flex-1 bg-gold/70" aria-hidden="true"></span>
      </div>
    )}
    <ul class="grid grid-cols-2 gap-y-10 lg:grid-cols-4">
      {items.map((it, i) => (
        <li
          class:list={[
            'flex flex-col items-center gap-3 px-4 text-center',
            'lg:border-l lg:border-white/25 lg:first:border-l-0',
            i % 2 === 1 && 'border-l border-white/25 lg:border-l',
          ]}
        >
          <Icon name={it.icon} size={44} strokeWidth={1.6} class="text-gold" />
          <span class="font-display text-lg leading-snug lg:text-xl">{it.title}</span>
          {it.text && <span class="text-[0.9375rem] text-muted">{it.text}</span>}
        </li>
      ))}
    </ul>
  </div>
</section>
