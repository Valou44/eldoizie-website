---
import { site } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const links = [
  { href: '/#accueil', label: 'Accueil' },
  { href: '/#services', label: 'Nos services' },
  { href: '/#vehicule', label: 'Notre véhicule' },
  { href: '/#zones', label: 'Zones d’intervention' },
  { href: '/#contact', label: 'Contact' },
];
---
<header class="fixed inset-x-0 top-0 z-30 border-b border-white/10 bg-night/95 backdrop-blur">
  <div class="container-site flex h-20 items-center justify-between gap-6">
    <Logo />
    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex gap-8 text-[0.9375rem] font-medium">
        {links.map((l, i) => (
          <li>
            <a
              href={l.href}
              class:list={[
                'link-draw whitespace-nowrap pb-1 hover:text-gold-light',
                i === 0 ? 'text-gold [background-size:100%_2px]' : 'text-ink-soft',
              ]}
            >{l.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <a href={site.phoneHref} class="btn-gold hidden min-h-12! px-6! text-base! md:inline-flex">
      <Icon name="phone" size={18} strokeWidth={2} />
      Réserver
    </a>
  </div>
</header>
