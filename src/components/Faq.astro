---
import Icon from './Icon.astro';
import { faq } from '../data/faq';
---
<section id="faq" class="block-y bg-ivory text-text">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-6">
    <div class="flex flex-col gap-6 lg:col-span-4">
      <span class="gold-rule" aria-hidden="true"></span>
      <h2 class="text-4xl leading-[1.1] lg:text-5xl">Questions fréquentes</h2>
      <p class="text-lg text-slate">Tout savoir sur le taxi conventionné et la prise en charge par l’Assurance Maladie.</p>
    </div>
    <div class="flex flex-col gap-3 lg:col-span-8">
      {faq.map((item, i) => (
        <details class="group rounded-xl bg-paper px-6 shadow-[0_2px_10px_rgba(11,21,48,0.06)]" open={i === 0}>
          <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-6 py-4 font-display text-xl [&::-webkit-details-marker]:hidden">
            {item.q}
            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-gold/15 text-gold-dark transition-transform duration-200 group-open:rotate-180">
              <Icon name="chevron" size={20} strokeWidth={2} />
            </span>
          </summary>
          <p class="pb-6 text-slate">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
