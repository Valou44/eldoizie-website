---
import { faq } from '../data/faq';
---
<section id="faq" class="screen-section bg-ivory text-text">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-6">
    <div class="flex flex-col gap-5 lg:col-span-5 lg:pr-10">
      <p class="label text-gold-dark">Questions fréquentes</p>
      <h2 class="text-4xl leading-[1.08] lg:text-5xl">Le taxi conventionné, en clair</h2>
    </div>
    <!-- FAQ ouverte en entier (Taste Skill : pas d'accordéon). -->
    <dl class="grid gap-x-10 border-t border-text/12 lg:col-span-7 lg:grid-cols-2">
      {faq.map((item) => (
        <div class="flex flex-col gap-2 border-b border-text/12 py-6">
          <dt class="font-display text-xl leading-snug">{item.q}</dt>
          <dd class="m-0 text-slate">{item.a}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
