---
import CallButton from './CallButton.astro';

const facts = [
  { title: 'Conventionné CPAM', text: 'Agréé Assurance Maladie' },
  { title: 'Tiers payant', text: 'Aucune avance de frais' },
  { title: 'Un seul chauffeur', text: 'Toujours le même visage' },
];
---
<section class="relative bg-night text-ink lg:h-svh lg:min-h-[52rem]">
  <div class="container-site grid h-full gap-12 pt-28 pb-16 lg:grid-cols-12 lg:gap-6 lg:pt-36 lg:pb-16">
    <div class="enter flex flex-col gap-7 lg:col-span-6 lg:pr-8">
      <p class="label text-gold">Taxi conventionné · Vendée et Pays de la Loire</p>
      <h1 class="text-[2.5rem] leading-[1.06] sm:text-6xl lg:text-[4.25rem]">
        Le taxi de vos rendez-vous médicaux, conduit avec égards.
      </h1>
      <p class="max-w-[34rem] text-lg leading-relaxed text-ink-soft lg:text-xl">
        Consultations, hospitalisations, dialyse, chimiothérapie : je viens vous chercher chez vous
        et je vous dépose devant le service. Avec votre bon de transport, vous n’avancez rien.
      </p>
      <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <CallButton id="hero-call" class="w-full sm:w-auto" />
        <a
          href="#prise-en-charge"
          class="btn-motion inline-flex min-h-14 items-center justify-center rounded-sm border border-ink/35 px-7 text-lg font-medium text-ink no-underline hover:border-ink"
        >Voir les démarches</a>
      </div>
      <dl class="mt-auto grid grid-cols-1 gap-5 pt-4 sm:grid-cols-3">
        {facts.map((f) => (
          <div class="flex flex-col gap-1 border-t border-gold/40 pt-4">
            <dt class="font-display text-xl text-ink">{f.title}</dt>
            <dd class="text-[0.9375rem] text-muted">{f.text}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="enter relative lg:col-span-5 lg:col-start-8" style="animation-delay: 120ms">
      <div class="absolute -top-4 -right-4 h-[85%] w-[80%] border border-gold/70 lg:-top-6 lg:-right-6" aria-hidden="true"></div>
      <!-- Photo d'illustration (stand-in) : à remplacer par la banquette arrière du véhicule du client. -->
      <img
        src="/img/photo-f201824352-960.jpg"
        srcset="/img/photo-f201824352-500.jpg 500w, /img/photo-f201824352-960.jpg 960w"
        sizes="(max-width: 1023px) 92vw, 36vw"
        width="960"
        height="1714"
        alt="Banquette arrière claire et spacieuse d’une berline, portière ouverte"
        fetchpriority="high"
        decoding="async"
        class="relative aspect-4/5 max-h-[70svh] w-full object-cover object-[50%_70%] lg:h-[calc(100svh-15rem)] lg:max-h-none lg:aspect-auto"
      />
      <div class="absolute bottom-6 left-0 flex flex-col gap-1 bg-ivory px-6 py-5 text-text shadow-[0_18px_40px_rgba(0,0,0,0.3)] lg:-left-8">
        <span class="font-display text-3xl leading-none">0 € d’avance</span>
        <span class="text-[0.9375rem] text-slate">avec votre bon de transport*</span>
      </div>
    </div>
  </div>
</section>
