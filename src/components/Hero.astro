---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section id="accueil" class="relative isolate overflow-hidden bg-night text-ink">
  <!-- Photo d'illustration (stand-in) : à remplacer par une photo du DS 7 du client, idéalement au crépuscule. -->
  <img
    src="/img/photo-f71613424.jpg"
    srcset="/img/photo-f71613424-500.jpg 500w, /img/photo-f71613424-960.jpg 960w, /img/photo-f71613424.jpg 1280w"
    sizes="100vw"
    width="1280"
    height="692"
    alt="DS 7 gris anthracite vu de trois quarts avant"
    fetchpriority="high"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[70%_60%] lg:left-auto lg:w-[82%] lg:object-[60%_55%]"
  />
  <!-- Fondu bleu nuit vers la photo + filet doré en diagonale -->
  <div class="absolute inset-0 -z-10 bg-linear-to-t from-night via-night/80 to-night/30 lg:bg-linear-to-r lg:from-night lg:from-35% lg:via-night/85 lg:via-50% lg:to-night/10" aria-hidden="true"></div>
  <div class="pointer-events-none absolute inset-y-0 left-[44%] -z-10 hidden w-1.5 -skew-x-[24deg] bg-linear-to-b from-gold/0 via-gold to-gold/0 lg:block" aria-hidden="true"></div>

  <div class="container-site flex min-h-[44rem] items-end pt-56 pb-16 sm:items-center sm:pt-32 lg:min-h-[42rem] lg:pt-32">
    <div class="enter flex max-w-[38rem] flex-col gap-7">
      <span class="gold-rule" aria-hidden="true"></span>
      <h1 class="font-sans text-base font-semibold text-gold sm:text-lg">
        Taxi conventionné à {site.city}, en Vendée
      </h1>
      <p class="-mt-3 font-display text-[2.6rem] leading-[1.08] font-medium tracking-[-0.015em] text-balance sm:text-6xl lg:text-[4rem]">
        Votre transport haut de gamme en Vendée
      </p>
      <p class="text-[0.8125rem] font-semibold tracking-[0.14em] text-ink uppercase sm:text-base sm:tracking-[0.2em]">
        Confort <span class="text-gold" aria-hidden="true">•</span> Sécurité <span class="text-gold" aria-hidden="true">•</span> Ponctualité
      </p>
      <p class="max-w-[32rem] text-lg text-ink-soft">
        Taxi conventionné CPAM, transferts gares et aéroports, trajets professionnels :
        au départ de {site.city}, à bord d’un {site.vehicle.model}.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row">
        <a id="hero-call" href={site.phoneHref} class="btn-gold">
          <Icon name="phone" size={20} strokeWidth={2} />
          Réserver votre course
          <Icon name="chevron-right" size={18} strokeWidth={2} />
        </a>
      </div>
    </div>
  </div>
</section>
