---
import Icon from './Icon.astro';
import { site } from '../data/site';

const medical = [
  {
    title: 'Consultations et examens',
    text: 'Spécialistes, imagerie, kinésithérapie. Je vous attends sur place et je vous raccompagne.',
  },
  {
    title: 'Dialyse, chimiothérapie, radiothérapie',
    text: 'Des séances régulières, aux mêmes horaires, avec le même chauffeur, semaine après semaine.',
  },
  {
    title: 'Entrées et sorties d’hôpital',
    text: 'CHD Vendée, CHU de Nantes, ICO, cliniques : aide aux bagages et à l’installation.',
  },
];

const privateTrips = [
  {
    title: 'Gares de Vendée et de Nantes',
    text: 'Un départ en train sans souci de stationnement, bagages chargés pour vous.',
    img: 'photo-f47003897',
    w: 960,
    h: 636,
    alt: 'Façade de la gare de La Roche-sur-Yon et son parvis',
  },
  {
    title: 'Aéroport Nantes-Atlantique',
    text: 'Aller et retour à l’heure de votre vol, de jour comme de nuit sur réservation.',
    img: 'photo-f122533004',
    w: 960,
    h: 640,
    alt: 'Façade du terminal de l’aéroport Nantes-Atlantique',
  },
];
---
<section id="services" class="screen-section bg-ivory text-text lg:min-h-[200svh]">
  <div class="container-site flex flex-col gap-24 lg:gap-0">
    <!-- Écran 1 : le médical -->
    <div class="grid gap-12 lg:min-h-[calc(100svh-12rem)] lg:grid-cols-12 lg:gap-6">
      <div class="flex flex-col gap-10 lg:col-span-6 lg:pr-10">
        <div class="flex flex-col gap-5">
          <p class="label text-gold-dark">Transport médical conventionné</p>
          <h2 class="text-4xl leading-[1.08] lg:text-5xl">Un trajet adapté à chaque rendez-vous de soin</h2>
        </div>
        <ul class="flex flex-col">
          {medical.map((s) => (
            <li class="flex flex-col gap-2 border-b border-text/12 py-6 first:pt-0">
              <h3 class="text-2xl lg:text-[1.75rem]">{s.title}</h3>
              <p class="text-slate">{s.text}</p>
            </li>
          ))}
        </ul>
      </div>
      <!-- Photo d'illustration (stand-in) : à remplacer par une photo du client devant un établissement de soins. -->
      <figure class="photo-zoom m-0 lg:col-span-6 lg:col-start-7">
        <img
          src="/img/photo-f24769147-960.jpg"
          srcset="/img/photo-f24769147-500.jpg 500w, /img/photo-f24769147-960.jpg 960w"
          sizes="(max-width: 1023px) 92vw, 46vw"
          width="960"
          height="640"
          alt="Vue sur le centre hospitalier de La Roche-sur-Yon au milieu des quartiers résidentiels"
          loading="lazy"
          decoding="async"
          class="aspect-4/5 h-full w-full object-cover lg:aspect-auto"
        />
      </figure>
    </div>

    <!-- Écran 2 : les trajets privés -->
    <div class="flex flex-col gap-12 lg:min-h-[100svh] lg:pt-48">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="flex max-w-[40rem] flex-col gap-5">
          <p class="label text-gold-dark">Trajets privés</p>
          <h2 class="text-4xl leading-[1.08] lg:text-5xl">Gares, aéroport et sorties, sur réservation</h2>
        </div>
        <a
          href={site.phoneHref}
          class="btn-motion inline-flex min-h-14 items-center gap-2.5 rounded-sm border border-text/40 px-6 text-lg font-medium text-text no-underline hover:border-text"
        >
          Demander un devis <Icon name="arrow" size={18} />
        </a>
      </div>
      <ul class="grid gap-6 md:grid-cols-2">
        {privateTrips.map((t) => (
          <li class="flex flex-col gap-5">
            <figure class="photo-zoom m-0">
              <img
                src={`/img/${t.img}-960.jpg`}
                srcset={`/img/${t.img}-500.jpg 500w, /img/${t.img}-960.jpg 960w`}
                sizes="(max-width: 767px) 92vw, 46vw"
                width={t.w}
                height={t.h}
                alt={t.alt}
                loading="lazy"
                decoding="async"
                class="aspect-3/2 w-full object-cover"
              />
            </figure>
            <h3 class="text-2xl lg:text-[1.75rem]">{t.title}</h3>
            <p class="max-w-[30rem] text-slate">{t.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
