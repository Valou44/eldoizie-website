---
import Icon from './Icon.astro';

const cards = [
  {
    icon: 'plane' as const,
    title: 'Transferts gares & aéroports',
    text: 'Voyagez l’esprit tranquille',
    detail: 'Aéroport Nantes-Atlantique et gares de Vendée, bagages pris en charge, à l’heure de votre vol ou de votre train.',
    img: 'photo-f122533004',
    w: 960, h: 639,
    alt: 'Terminal de l’aéroport Nantes-Atlantique',
    pos: 'object-center',
  },
  {
    icon: 'briefcase' as const,
    title: 'Transport entreprises',
    text: 'Une solution fiable et flexible',
    detail: 'Rendez-vous clients, séminaires, accueil de collaborateurs : un chauffeur ponctuel et discret, facture au nom de l’entreprise.',
    img: 'photo-f166946901',
    w: 960, h: 720,
    alt: 'DS 7 noir circulant en ville',
    pos: 'object-[50%_60%]',
  },
  {
    icon: 'cross' as const,
    title: 'Transports médicaux',
    text: 'Conventionné CPAM',
    detail: 'Consultations, hospitalisations, dialyse, chimiothérapie : sans avance de frais avec votre bon de transport.',
    img: 'photo-f134681297',
    w: 960, h: 656,
    alt: 'Stéthoscope posé sur un fond clair',
    pos: 'object-center',
  },
];
---
<section id="services" class="block-y bg-ivory pt-0! text-text">
  <div class="container-site flex flex-col gap-14">
    <div class="flex items-center gap-6">
      <span class="h-px flex-1 bg-gold" aria-hidden="true"></span>
      <h2 class="text-center text-4xl lg:text-5xl">Nos services</h2>
      <span class="h-px flex-1 bg-gold" aria-hidden="true"></span>
    </div>
    <ul class="grid gap-8 md:grid-cols-3 md:gap-6 lg:gap-8">
      {cards.map((c) => (
        <li class="group flex flex-col gap-5">
          <div class="photo-zoom relative overflow-hidden rounded-xl shadow-[0_18px_40px_rgba(11,21,48,0.18)] transition-transform duration-200 group-hover:-translate-y-0.5">
            <img
              src={`/img/${c.img}-960.jpg`}
              srcset={`/img/${c.img}-500.jpg 500w, /img/${c.img}-960.jpg 960w`}
              sizes="(max-width: 767px) 92vw, 30vw"
              width={c.w}
              height={c.h}
              alt={c.alt}
              loading="lazy"
              decoding="async"
              class:list={['aspect-[4/3.4] w-full object-cover', c.pos]}
            />
            <div class="absolute inset-x-3 bottom-3 flex items-center gap-4 rounded-lg bg-night/90 px-5 py-4 text-ink backdrop-blur-sm">
              <Icon name={c.icon} size={32} strokeWidth={1.7} class="shrink-0 text-gold" />
              <div class="flex flex-col">
                <h3 class="text-lg leading-tight lg:text-xl">{c.title}</h3>
                <p class="text-[0.9375rem] text-ink-soft">{c.text}</p>
              </div>
            </div>
          </div>
          <p class="px-1 text-slate">{c.detail}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
