---
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { site } from '../data/site';

const vehicle = [
  { label: 'Véhicule', value: site.vehicle.model },
  { label: 'Passagers', value: `${site.vehicle.seats} places` },
  { label: 'Accès', value: 'Montée facilitée, aide au bras' },
  { label: 'Fauteuil', value: 'Fauteuil pliant accepté au coffre' },
];
---
<section id="chauffeur" class="screen-section bg-night text-ink">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-6">
    <!-- Emplacement client : portrait du chauffeur à côté de son véhicule (jamais une photo de banque d'images). -->
    <PhotoPlaceholder label="Portrait du chauffeur à côté de son véhicule" class="aspect-4/5 w-full lg:col-span-5 lg:aspect-auto lg:h-[calc(100svh-12rem)]" />
    <div class="flex flex-col gap-10 lg:col-span-6 lg:col-start-7">
      <div class="flex flex-col gap-5">
        <p class="label text-gold">Votre chauffeur</p>
        <h2 class="text-4xl leading-[1.08] lg:text-5xl">Un seul chauffeur, une seule voiture, toujours le même visage</h2>
        <p class="text-lg text-ink-soft">
          {site.driver}, artisan taxi installé à {site.city}. Je conduis chaque patient comme je
          conduirais mes proches : à l’heure, sans brusquer, avec le temps qu’il faut pour monter et
          descendre. [Parcours en deux phrases.]
        </p>
      </div>
      <dl id="vehicule" class="grid border-t border-white/15 sm:grid-cols-2 sm:gap-x-6">
        {vehicle.map((v) => (
          <div class="flex flex-col gap-1 border-b border-white/15 py-5">
            <dt class="label text-muted">{v.label}</dt>
            <dd class="font-display text-xl">{v.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
