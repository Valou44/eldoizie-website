---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section id="contact" class="border-y border-gold/30 bg-night-2 text-ink">
  <div class="container-site flex flex-col gap-8 py-14 lg:flex-row lg:items-center lg:justify-between lg:py-16">
    <div class="flex items-center gap-5">
      <span class="flex size-16 shrink-0 items-center justify-center rounded-full bg-gold text-night" aria-hidden="true">
        <Icon name="phone" size={28} strokeWidth={2} />
      </span>
      <div class="flex flex-col gap-1">
        <h2 class="text-2xl lg:text-3xl">Réservez dès maintenant votre course</h2>
        <p class="text-ink-soft">Par téléphone ou par e-mail · {site.hours.label}</p>
      </div>
    </div>
    <div class="flex flex-col gap-3 sm:flex-row">
      <a href={site.phoneHref} class="btn-gold">
        <Icon name="phone" size={20} strokeWidth={2} /> {site.phone}
      </a>
      <a href={`mailto:${site.email}`} class="btn-outline">
        <Icon name="mail" size={20} /> Contactez-nous
      </a>
    </div>
  </div>
</section>
