---
/**
 * Barre d'appel fixe sur mobile. Elle n'apparaît qu'une fois le bouton d'appel du héros sorti
 * de l'écran, et se cache quand un autre bouton d'appel est visible (pas deux fois la même action).
 */
import { site } from '../data/site';
import Icon from './Icon.astro';
---
<nav
  id="call-bar"
  aria-label="Appel rapide"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-white/15 bg-night px-6 pt-3 transition-transform duration-200 md:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom))"
>
  <a
    href={site.phoneHref}
    class="flex min-h-14 w-full items-center justify-center gap-3 rounded-sm bg-gold text-xl font-semibold text-night no-underline active:bg-gold-light"
  >
    <Icon name="phone" size={24} strokeWidth={2} />
    Appeler le taxi
  </a>
</nav>

<script>
  const bar = document.getElementById('call-bar');
  const targets = document.querySelectorAll('main a[href^="tel:"], footer a[href^="tel:"]');
  if (bar && targets.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const update = () => {
      const hide = visible.size > 0;
      bar.style.transform = hide ? 'translateY(100%)' : '';
      bar.inert = hide;
    };
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) e.isIntersecting ? visible.add(e.target) : visible.delete(e.target);
      update();
    });
    targets.forEach((t) => io.observe(t));
  }
</script>
