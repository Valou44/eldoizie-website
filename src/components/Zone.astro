---
import Icon from './Icon.astro';
import { site } from '../data/site';

const destinations = [
  { city: 'La Roche-sur-Yon', places: 'CHD Vendée, cliniques' },
  { city: 'Nantes', places: 'CHU, ICO René Gauducheau' },
  { city: 'Angers', places: 'CHU, ICO Paul Papin' },
  { city: 'Cholet', places: 'Centre hospitalier' },
  { city: 'Les Sables-d’Olonne', places: 'Centre hospitalier Côte de Lumière' },
];
---
<section id="zone" class="screen-section bg-ivory text-text">
  <div class="container-site grid gap-12 lg:grid-cols-12 lg:gap-6">
    <div class="flex flex-col gap-10 lg:col-span-6 lg:pr-10">
      <div class="flex flex-col gap-5">
        <p class="label text-gold-dark">Secteur d’intervention</p>
        <h2 class="text-4xl leading-[1.08] lg:text-5xl">De la Vendée à tout le Pays de la Loire</h2>
        <p class="text-lg text-slate">
          Basé à {site.city}, je vous prends en charge à domicile partout en Vendée et je vous conduis
          vers les établissements de soins de la région, aller et retour.
        </p>
      </div>
      <ul class="flex flex-col border-t border-text/12">
        {destinations.map((d) => (
          <li class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-text/12 py-4">
            <span class="flex items-center gap-3 font-display text-[1.375rem]">
              <Icon name="pin" size={20} class="shrink-0 text-gold-dark" />
              {d.city}
            </span>
            <span class="text-slate">{d.places}</span>
          </li>
        ))}
      </ul>
    </div>
    <!-- Photo d'illustration (stand-in) : à remplacer par un paysage vendéen photographié par le client. -->
    <figure class="photo-zoom m-0 lg:col-span-6 lg:col-start-7">
      <img
        src="/img/photo-f134639190-960.jpg"
        srcset="/img/photo-f134639190-500.jpg 500w, /img/photo-f134639190-960.jpg 960w"
        sizes="(max-width: 1023px) 92vw, 46vw"
        width="960"
        height="722"
        alt="Le front de mer des Sables-d’Olonne par une journée ensoleillée"
        loading="lazy"
        decoding="async"
        class="aspect-4/5 h-full w-full object-cover lg:aspect-auto"
      />
    </figure>
  </div>
</section>
