---
import '@fontsource/great-vibes/latin-400.css';
import Icon from './Icon.astro';
import VendeeMap from './VendeeMap.astro';
import { site } from '../data/site';

const cities = ['Saint-Gervais', 'Challans', 'La Roche-sur-Yon'];
const mapUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${site.city} ${site.postalCode}`)}`;
---
<section id="zones" class="relative isolate overflow-hidden bg-night text-ink">
  <!-- Photo d'illustration (stand-in) : phare de l'Armandèche aux Sables-d'Olonne. Fondu vers le bleu nuit à gauche. -->
  <img
    src="/img/photo-f41632672-960.jpg"
    srcset="/img/photo-f41632672-500.jpg 500w, /img/photo-f41632672-960.jpg 960w"
    sizes="(max-width: 1023px) 100vw, 45vw"
    width="960"
    height="1442"
    alt=""
    loading="lazy"
    decoding="async"
    class="absolute inset-y-0 right-0 -z-20 h-full w-full object-cover object-[50%_35%] opacity-30 lg:w-[60%] lg:opacity-100 lg:[mask-image:linear-gradient(to_right,transparent,black_45%)]"
  />
  <div class="absolute inset-0 -z-10 bg-night/60 lg:bg-transparent lg:bg-linear-to-r lg:from-night lg:from-40% lg:via-night/55 lg:via-65% lg:to-night/0" aria-hidden="true"></div>

  <div class="container-site grid grid-cols-1 items-center gap-12 py-20 lg:grid-cols-12 lg:gap-6 lg:py-28">
    <div class="flex min-w-0 flex-col gap-6 lg:col-span-6">
      <span class="gold-rule" aria-hidden="true"></span>
      <h2 class="text-4xl leading-[1.1] lg:text-5xl">Nos zones d’intervention</h2>
      <p class="max-w-[34rem] text-lg text-ink-soft">
        Basé à {site.city}, {site.name} intervient en Vendée et dans toute la région pour vous
        accompagner, jusqu’au CHU de Nantes, à Angers ou à Cholet.
      </p>
      <div class="flex items-start gap-4">
        <Icon name="pin" size={40} strokeWidth={1.8} class="shrink-0 text-gold" />
        <p class="min-w-0 text-lg">
          <span class="flex flex-wrap gap-x-3 gap-y-1">
            {cities.map((c, i) => (
              <span class="whitespace-nowrap">
                {i > 0 && <span class="pr-3 text-gold" aria-hidden="true">•</span>}{c}
              </span>
            ))}
          </span>
          <span class="text-ink-soft">et leurs alentours</span>
        </p>
      </div>
      <a href={mapUrl} rel="noopener" class="btn-gold mt-2 self-start">
        Voir la carte <Icon name="chevron-right" size={18} strokeWidth={2} />
      </a>
    </div>

    <!-- Carte au premier plan, à cheval sur le fondu vers la photo -->
    <div class="relative min-w-0 lg:col-span-6 lg:-ml-8 lg:pr-[22%]">
      <VendeeMap class="mx-auto w-full max-w-[30rem] drop-shadow-[0_10px_30px_rgba(0,0,0,0.45)]" />
    </div>
  </div>
</section>
